{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".wrangler",
    "apps/mobile/ios",
    "apps/mobile/android",
    "*.md",
    "assets/**",
    "**/*.png",
    "**/*.jpg",
    "coverage",
    "bun.lock"
  ]
}
