{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "promise",
    "jsx-a11y",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-throw-literal": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/ban-ts-comment": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/no-danger": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/no-autofocus": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**", "apps/api/tests/**", "apps/api/src/db/seed*.ts", "**/*.test.ts"],
      "rules": {
        "no-console": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off"
      }
    },
    {
      "files": ["apps/api/**", "packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react-native",
                "message": "Server and shared packages must stay isomorphic. Move native code to apps/mobile."
              },
              {
                "name": "expo",
                "message": "Server and shared packages must stay isomorphic. Move Expo code to apps/mobile."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.expo/**",
    "**/ios/**",
    "**/android/**",
    "**/data/**",
    "**/uploads/**",
    "**/.cache/**",
    "**/.tools/**",
    "**/.impeccable/**",
    "**/assets/**",
    "bun.lock"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  }
}
